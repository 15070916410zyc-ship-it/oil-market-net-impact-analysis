{
  "functions": {
    "api/models.py": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/models/:path*", "destination": "/api/models.py/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/decision", "destination": "/index.html" },
    { "source": "/professional", "destination": "/index.html" },
    { "source": "/data", "destination": "/index.html" }
  ]
}
